{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent-authored generation brief",
  "type": "object",
  "required": [
    "product",
    "version",
    "updated_at",
    "language",
    "identity",
    "pending",
    "documents"
  ],
  "additionalProperties": false,
  "properties": {
    "product": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "language": {
      "enum": [
        "pt-BR",
        "en",
        "es"
      ]
    },
    "identity": {
      "type": "object",
      "properties": {
        "legal_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "privacy_contact": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "pending": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "title",
          "applicable",
          "applicability_reason",
          "sections",
          "source_ids",
          "evidence_ids",
          "pending"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "terms-of-service",
              "privacy-policy",
              "cookie-policy",
              "ai-policy",
              "acceptable-use",
              "data-deletion",
              "data-processing-agreement",
              "consent-notice",
              "incident-response"
            ]
          },
          "title": {
            "type": "string"
          },
          "applicable": {
            "type": "boolean"
          },
          "applicability_reason": {
            "type": "string"
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "heading",
                "body"
              ],
              "additionalProperties": false,
              "properties": {
                "heading": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                }
              }
            }
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pending": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
