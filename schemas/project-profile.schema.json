{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Static project profile",
  "type": "object",
  "required": [
    "schema_version",
    "product",
    "scanned_at",
    "files_scanned",
    "scope",
    "frameworks",
    "findings",
    "configuration_checks",
    "coverage",
    "unknowns",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "product": {
      "type": "string"
    },
    "scanned_at": {
      "type": "string",
      "format": "date-time"
    },
    "files_scanned": {
      "type": "integer",
      "minimum": 0
    },
    "scope": {
      "const": "static_source_only"
    },
    "frameworks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "signal",
          "category",
          "file",
          "line",
          "context",
          "confidence",
          "production_verified",
          "file_sha256",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "signal": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "context": {
            "enum": [
              "test_or_example",
              "schema_only",
              "dependency_declared",
              "configuration_reference",
              "code_reference"
            ]
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "production_verified": {
            "const": false
          },
          "file_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "configuration_checks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "coverage": {
      "type": "object"
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "const": "REQUIRES_HUMAN_REVIEW"
    }
  }
}
